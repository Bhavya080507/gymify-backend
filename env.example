# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=mysql://username:password@localhost:3306/gym_whatsapp_bot

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Scheduler
TIMEZONE=Asia/Kolkata
MORNING_PROMPT_HOUR=7
MORNING_PROMPT_MINUTE=0

# Logging
LOG_LEVEL=info
